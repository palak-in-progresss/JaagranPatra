// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
   provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Simplified user roles
enum UserRole {
  ADMIN
  CITIZEN
  MEMBER
  MLA
}

enum IssueStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum UpdateType {
  MEMBER_UPDATE    // Updates from assigned MEMBER
  CITIZEN_COMMENT  // Comments from CITIZENS
  STATUS_CHANGE    // System-generated status changes
  ASSIGNMENT       // Assignment notifications
}

enum MediaType {
  TEXT
  AUDIO
  IMAGE
  VIDEO
  DOCUMENT
}

enum SessionStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

// Body types for different political/administrative bodies
enum BodyType {
  SHAKTI_KENDRA
  PANNA_PRAMUKH
  LOCAL_BODY
  POLLING_BOOTH
  WARD
  BLOCK
  MANDAL
  TEHSIL
  GRAM_PANCHAYAT
  MUNICIPALITY
  CORPORATION
  OTHER
}

enum ChatGroupType {
  PUBLIC_MLA_GROUP     // Anyone can join and message
  PRIVATE_MLA_GROUP    // Only MLA and their associated members
}

enum MembershipStatus {
  ACTIVE
  REMOVED
  LEFT
}

// Simplified User model
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  phone       String?  @unique
  name        String
  role        UserRole
  avatar      String?
  isActive    Boolean  @default(true)
  isVerified  Boolean  @default(false)
  gender      String?
  dateOfBirth DateTime?
  
  // Authentication
  password    String
  lastLogin   DateTime?
  loginCount  Int      @default(0)
  resetToken  String?
  resetTokenExpiry DateTime?
  emailVerificationToken String?
  phoneVerificationToken String?
  
  // Location data - simplified
  stateId     String?
  districtId  String?
  constituencyId String?
  bodyId      String?  // Generic body association
  
  // Current location tracking
  currentLatitude   Float?
  currentLongitude  Float?
  currentAddress    String?
  lastLocationUpdate DateTime?
  
  // Relationships
  state       State?        @relation(fields: [stateId], references: [id])
  district    District?     @relation(fields: [districtId], references: [id])
  constituency Constituency? @relation(fields: [constituencyId], references: [id])
  body        Body?         @relation(fields: [bodyId], references: [id])
  
  // MLA specific
  mlaProfile  MlaProfile?
  
  // Member specific
  memberProfile MemberProfile?
  
  // MLA-Member relationship
  mlaId       String?
  mla         User?     @relation("MlaMembers", fields: [mlaId], references: [id])
  members     User[]    @relation("MlaMembers")
  
  // Issues
  reportedIssues Issue[] @relation("ReportedBy")
  assignedIssues Issue[] @relation("AssignedTo")
  issueUpdates IssueUpdate[]
  
  // Sessions
  hostedSessions Session[] @relation("HostedBy")
  sessionParticipants SessionParticipant[]
  
  // Notifications
  sentNotifications Notification[] @relation("SentBy")
  receivedNotifications NotificationRecipient[]
  
  // Chat
  chatMessages ChatMessage[]
  
  // News
  newsArticles News[]
  
  // Performance tracking
  performanceMetrics PerformanceMetric[]
  
  // Device tracking for push notifications
  deviceTokens DeviceToken[]

  ownedGroups     ChatGroup[]         @relation("GroupOwner")
  groupMemberships ChatGroupMember[]  @relation("GroupMembership")
  addedMembers    ChatGroupMember[]   @relation("MemberAddedBy")
  groupMessages   ChatGroupMessage[]  @relation("GroupMessageSender")
  messageReads    ChatMessageRead[]   @relation("MessageReader")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([stateId])
  @@index([districtId])
  @@index([constituencyId])
  @@index([bodyId])
  @@index([mlaId])
  @@index([isActive])
  @@index([createdAt])
  @@index([currentLatitude, currentLongitude])
  @@map("users")
}

// Member profile for different body types
model MemberProfile {
  id              String @id @default(cuid())
  userId          String @unique
  bodyType        BodyType?  // Type of body they belong to
  designation     String?
  description     String?
  
  // Permissions for different actions
  canReceiveIssues Boolean @default(true)
  canUpdateIssues  Boolean @default(true)
  canCreateSessions Boolean @default(false)
  
  // Performance metrics
  totalIssues     Int @default(0)
  resolvedIssues  Int @default(0)
  pendingIssues   Int @default(0)
  avgResolutionTime Float @default(0)
  
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([bodyType])
  @@index([totalIssues])
  @@index([resolvedIssues])
  @@map("member_profiles")
}

// Enhanced MLA Profile
model MlaProfile {
  id              String @id @default(cuid())
  userId          String @unique
  constituencyId  String
  partyName       String?
  position        String?
  tenure          String?
  bio             String?
  achievements    String?
  contactEmail    String?
  contactPhone    String?
  socialLinks     Json?
  
  // Performance metrics
  totalIssues     Int @default(0)
  resolvedIssues  Int @default(0)
  pendingIssues   Int @default(0)
  avgResolutionTime Float @default(0)
  
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  constituency    Constituency @relation(fields: [constituencyId], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([constituencyId])
  @@index([totalIssues])
  @@index([resolvedIssues])
  @@map("mla_profiles")
}

// Device token management for push notifications
model DeviceToken {
  id        String @id @default(cuid())
  userId    String
  token     String @unique
  platform  String // "ios", "android", "web"
  isActive  Boolean @default(true)
  
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
  @@index([token])
  @@map("device_tokens")
}

// Geographic hierarchy
model State {
  id          String @id @default(cuid())
  name        String @unique
  code        String @unique
  latitude    Float?
  longitude   Float?
  
  districts   District[]
  constituencies Constituency[]
  bodies      Body[]
  users       User[]
  issues      Issue[]
  news        News[]
  notifications Notification[]
  chatGroups  ChatGroup[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([code])
  @@map("states")
}

model District {
  id          String @id @default(cuid())
  name        String
  code        String
  stateId     String
  latitude    Float?
  longitude   Float?
  
  state       State @relation(fields: [stateId], references: [id], onDelete: Cascade)
  constituencies Constituency[]
  bodies      Body[]
  users       User[]
  issues      Issue[]
  chatGroups  ChatGroup[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([stateId, code])
  @@index([stateId])
  @@map("districts")
}

model Constituency {
  id          String @id @default(cuid())
  name        String
  code        String
  type        String
  stateId     String
  districtId  String
  latitude    Float?
  longitude   Float?
  
  state       State @relation(fields: [stateId], references: [id], onDelete: Cascade)
  district    District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  bodies      Body[]
  users       User[]
  mlaProfiles MlaProfile[]
  issues      Issue[]
  chatGroups  ChatGroup[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([stateId, code])
  @@index([stateId])
  @@index([districtId])
  @@map("constituencies")
}

// Generic Body model for all political/administrative bodies
model Body {
  id              String @id @default(cuid())
  name            String
  code            String
  type            BodyType
  description     String?
  
  // Hierarchical structure
  stateId         String?
  districtId      String?
  constituencyId  String?
  parentBodyId    String?    // For nested bodies
  
  // Location data
  address         String?
  latitude        Float?
  longitude       Float?
  
  // Administrative data
  headName        String?    // Head of this body
  contactEmail    String?
  contactPhone    String?
  
  // Relationships
  state           State? @relation(fields: [stateId], references: [id])
  district        District? @relation(fields: [districtId], references: [id])
  constituency    Constituency? @relation(fields: [constituencyId], references: [id])
  parentBody      Body? @relation("BodyHierarchy", fields: [parentBodyId], references: [id])
  childBodies     Body[] @relation("BodyHierarchy")
  
  // Users associated with this body
  users           User[]
  issues          Issue[]
  
  isActive        Boolean @default(true)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([stateId, districtId, constituencyId, code, type])
  @@index([type])
  @@index([stateId])
  @@index([districtId])
  @@index([constituencyId])
  @@index([parentBodyId])
  @@index([isActive])
  @@map("bodies")
}

model Issue {
  id              String @id @default(cuid())
  title           String
  description     String
  category        String
  status          IssueStatus @default(PENDING)
  priority        IssuePriority @default(MEDIUM)
  
  // Media attachments for initial issue report
  voiceNote       String?    // URL to voice recording
  images          Json?      // Array of image URLs
  isUrgent        Boolean @default(false)
  
  // Location
  stateId         String
  districtId      String?
  constituencyId  String?
  bodyId          String?    // Generic body association
  address         String?
  latitude        Float?
  longitude       Float?
  
  // Assignment
  reportedById    String
  assignedToId    String?
  
  // Tracking
  expectedResolutionDate DateTime?
  actualResolutionDate   DateTime?
  resolutionNotes        String?
  
  // Media
  attachments     Json?
  beforeImages    Json?
  afterImages     Json?
  
  // Relationships
  state           State @relation(fields: [stateId], references: [id])
  district        District? @relation(fields: [districtId], references: [id])
  constituency    Constituency? @relation(fields: [constituencyId], references: [id])
  body            Body? @relation(fields: [bodyId], references: [id])
  reportedBy      User @relation("ReportedBy", fields: [reportedById], references: [id])
  assignedTo      User? @relation("AssignedTo", fields: [assignedToId], references: [id])
  
  updates         IssueUpdate[]
  chatMessages    ChatMessage[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([stateId])
  @@index([districtId])
  @@index([constituencyId])
  @@index([bodyId])
  @@index([reportedById])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([latitude, longitude])
  @@map("issues")
}

model IssueUpdate {
  id          String @id @default(cuid())
  issueId     String
  userId      String
  message     String?
  status      IssueStatus?
  updateType  UpdateType @default(CITIZEN_COMMENT)
  mediaType   MediaType @default(TEXT)
  
  // Media attachments for updates
  audioUrl    String?    // URL to audio recording
  imageUrls   Json?      // Array of image URLs
  attachments Json?      // Other attachments
  
  // For member updates - additional tracking
  hoursWorked Float?
  progressPercentage Int?
  nextSteps   String?
  
  issue       Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [userId], references: [id])
  
  createdAt   DateTime @default(now())
  
  @@index([issueId])
  @@index([userId])
  @@index([updateType])
  @@index([createdAt])
  @@map("issue_updates")
}

model Session {
  id              String @id @default(cuid())
  title           String
  description     String?
  scheduledAt     DateTime
  duration        Int
  status          SessionStatus @default(SCHEDULED)
  meetingLink     String?
  agenda          String?
  summary         String?
  
  // Zoom integration fields
  zoomMeetingId   String?
  zoomMeetingData Json?
  isOpenToAll     Boolean @default(false)
  isRecurring     Boolean @default(false)
  recurrenceData  Json?
  
  hostId          String
  
  host            User @relation("HostedBy", fields: [hostId], references: [id])
  participants    SessionParticipant[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([hostId])
  @@index([scheduledAt])
  @@index([status])
  @@index([zoomMeetingId])
  @@index([isOpenToAll])
  @@index([isRecurring])
  @@map("sessions")
}

model SessionParticipant {
  id          String @id @default(cuid())
  sessionId   String
  userId      String
  invitedAt   DateTime @default(now())
  respondedAt DateTime?
  status      String @default("INVITED")
  
  session     Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [userId], references: [id])
  
  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
  @@map("session_participants")
}

model News {
  id          String @id @default(cuid())
  title       String
  content     String
  summary     String?
  category    String?
  tags        String[]
  isActive    Boolean @default(true)
  isPinned    Boolean @default(false)
  
  stateId     String?
  isNational  Boolean @default(false)
  
  featuredImage String?
  attachments   Json?
  
  slug        String @unique
  metaTitle   String?
  metaDescription String?
  
  state       State? @relation(fields: [stateId], references: [id])
  author      User @relation(fields: [authorId], references: [id])
  authorId    String
  
  viewCount   Int @default(0)
  
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([isActive])
  @@index([isPinned])
  @@index([stateId])
  @@index([publishedAt])
  @@index([slug])
  @@map("news")
}

model Notification {
  id          String @id @default(cuid())
  title       String
  message     String
  type        String
  data        Json?
  
  sentById    String
  
  targetRole  UserRole?
  targetStateId String?
  
  sentBy      User @relation("SentBy", fields: [sentById], references: [id])
  state       State? @relation(fields: [targetStateId], references: [id])
  recipients  NotificationRecipient[]
  
  createdAt   DateTime @default(now())
  
  @@index([type])
  @@index([targetRole])
  @@index([targetStateId])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationRecipient {
  id              String @id @default(cuid())
  notificationId  String
  userId          String
  status          NotificationStatus @default(PENDING)
  readAt          DateTime?
  
  notification    Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user            User @relation(fields: [userId], references: [id])
  
  createdAt       DateTime @default(now())
  
  @@unique([notificationId, userId])
  @@index([userId])
  @@index([status])
  @@map("notification_recipients")
}

model ChatGroup {
  id          String        @id @default(cuid())
  name        String
  description String?
  type        ChatGroupType
  
  // Group owner (MLA)
  ownerId     String
  owner       User         @relation("GroupOwner", fields: [ownerId], references: [id])
  
  // For location-based groups
  stateId     String?
  districtId  String?
  constituencyId String?
  
  state       State?       @relation(fields: [stateId], references: [id])
  district    District?    @relation(fields: [districtId], references: [id])
  constituency Constituency? @relation(fields: [constituencyId], references: [id])
  
  isActive    Boolean      @default(true)
  
  // Relationships
  members     ChatGroupMember[]
  messages    ChatGroupMessage[]
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  @@index([ownerId])
  @@index([type])
  @@index([stateId])
  @@index([constituencyId])
  @@index([isActive])
  @@map("chat_groups")
}
model ChatGroupMessage {
  id          String    @id @default(cuid())
  groupId     String
  senderId    String
  message     String
  messageType String    @default("TEXT") // TEXT, IMAGE, AUDIO, FILE
  
  // File attachments
  attachments Json?
  
  // Message status
  isEdited    Boolean   @default(false)
  editedAt    DateTime?
  
  group       ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender      User      @relation("GroupMessageSender", fields: [senderId], references: [id])
  
  // Read receipts
  readBy      ChatMessageRead[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([groupId])
  @@index([senderId])
  @@index([createdAt])
  @@map("chat_group_messages")
}

model ChatMessageRead {
  id        String           @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime         @default(now())
  
  message   ChatGroupMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User            @relation("MessageReader", fields: [userId], references: [id])
  
  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@map("chat_message_reads")
}

model ChatGroupMember {
  id          String           @id @default(cuid())
  groupId     String
  userId      String
  status      MembershipStatus @default(ACTIVE)
  
  // Who added this member (for tracking)
  addedById   String?
  addedBy     User?           @relation("MemberAddedBy", fields: [addedById], references: [id])
  
  // Permissions
  canInvite   Boolean         @default(false)
  canRemove   Boolean         @default(false)
  
  group       ChatGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user        User            @relation("GroupMembership", fields: [userId], references: [id])
  
  joinedAt    DateTime        @default(now())
  leftAt      DateTime?
  
  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@index([status])
  @@map("chat_group_members")
}


model ChatMessage {
  id          String @id @default(cuid())
  senderId    String
  receiverId  String?
  issueId     String?
  message     String
  messageType String @default("TEXT")
  attachments Json?
  isRead      Boolean @default(false)
  
  sender      User @relation(fields: [senderId], references: [id])
  issue       Issue? @relation(fields: [issueId], references: [id])
  
  createdAt   DateTime @default(now())
  
  @@index([senderId])
  @@index([receiverId])
  @@index([issueId])
  @@index([createdAt])
  @@map("chat_messages")
}

model PerformanceMetric {
  id              String @id @default(cuid())
  userId          String
  metricType      String
  value           Float
  period          String
  date            DateTime
  
  user            User @relation(fields: [userId], references: [id])
  
  createdAt       DateTime @default(now())
  
  @@unique([userId, metricType, period, date])
  @@index([userId])
  @@index([metricType])
  @@index([period])
  @@index([date])
  @@map("performance_metrics")
}

model ChatbotKnowledge {
  id          String @id @default(cuid())
  question    String
  answer      String
  category    String?
  keywords    String[]
  isActive    Boolean @default(true)
  
  usageCount  Int @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([category])
  @@index([isActive])
  @@index([keywords])
  @@map("chatbot_knowledge")
}

model SystemConfig {
  id          String @id @default(cuid())
  key         String @unique
  value       String
  description String?
  isActive    Boolean @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([key])
  @@map("system_config")
}

model MeetingReminder {
  id          String @id @default(cuid())
  reminderKey String @unique
  sentAt      DateTime
  
  createdAt   DateTime @default(now())
  
  @@index([reminderKey])
  @@index([sentAt])
  @@map("meeting_reminders")
}
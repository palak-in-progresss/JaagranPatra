# Server Configuration
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/jaagranpatra?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/jaagranpatra?schema=public"

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# SMTP Configuration (Nodemailer Email Service)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Jaagran Patra <noreply@jaagranpatra.com>"

# Zoom Server-to-Server OAuth Configuration
ZOOM_ACCOUNT_ID=your-zoom-account-id
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret
ZOOM_MASTER_USER_ID=me

# Cloudinary Media Storage (Optional if using local uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Maps API Key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key